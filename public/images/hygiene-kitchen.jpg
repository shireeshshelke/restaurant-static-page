<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 300" width="300" height="300">
  <defs>
    <linearGradient id="kitchen" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ecf0f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#bdc3c7;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="300" height="300" fill="url(#kitchen)"/>
  <rect x="60" y="80" width="180" height="140" fill="#34495e" stroke="#2c3e50" stroke-width="2" rx="5"/>
  <circle cx="100" cy="110" r="18" fill="#ecf0f1" opacity="0.7"/>
  <circle cx="150" cy="110" r="18" fill="#ecf0f1" opacity="0.7"/>
  <circle cx="200" cy="110" r="18" fill="#ecf0f1" opacity="0.7"/>
  <rect x="80" y="140" width="140" height="50" fill="#95a5a6" opacity="0.6" rx="3"/>
  <text x="150" y="240" font-family="Arial, sans-serif" font-size="18" font-weight="bold" text-anchor="middle" fill="#2c3e50">
    Clean Kitchen
  </text>
  <text x="150" y="270" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#7f8c8d">
    Professional & Hygienic
  </text>
</svg>